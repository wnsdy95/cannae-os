{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/commander-intent.schema.json",
  "title": "Plan-bound Commander Intent",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "type", "id", "mission_id", "wave_id", "plan_id", "agent_id", "parent_intent_id", "purpose", "key_tasks", "end_state", "failure_to_avoid", "constraints", "authority_boundary"],
  "properties": {
    "schema_version": { "const": "0.1" }, "type": { "const": "CommanderIntent" },
    "id": { "$ref": "common.schema.json#/$defs/id" }, "mission_id": { "$ref": "common.schema.json#/$defs/id" },
    "wave_id": { "type": "string", "minLength": 1 }, "plan_id": { "$ref": "common.schema.json#/$defs/id" },
    "agent_id": { "type": "string", "minLength": 1 },
    "parent_intent_id": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/id" }] },
    "purpose": { "type": "string", "minLength": 1 },
    "key_tasks": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "intent-continuity-common.schema.json#/$defs/task" } },
    "end_state": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "failure_to_avoid": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authority_boundary": { "$ref": "intent-continuity-common.schema.json#/$defs/boundary" }
  }
}
