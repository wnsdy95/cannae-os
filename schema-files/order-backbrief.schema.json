{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/order-backbrief.schema.json",
  "title": "OrderBackbrief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "mission_id",
    "wave_id",
    "type",
    "proposal_ref",
    "agent_id",
    "backbrief",
    "task_acknowledgement",
    "execution_authorized",
    "continuation_authorized",
    "release_authorized",
    "human_final_decision_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "mission_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "wave_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "type": {
      "const": "OrderBackbrief"
    },
    "proposal_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "backbrief": {
      "$ref": "backbrief.schema.json"
    },
    "task_acknowledgement": {
      "$ref": "order-draft.schema.json#/properties/opord/properties/execution/properties/tasks/items"
    },
    "execution_authorized": {
      "const": false
    },
    "continuation_authorized": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "human_final_decision_authority": {
      "const": "USER"
    }
  }
}
