{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/intent-delegation-event.schema.json",
  "title": "Plan-bound Intent Delegation Event",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "type", "id", "mission_id", "wave_id", "parent_intent_id", "child_intent_id", "delegator_agent_id", "delegate_agent_id", "delegated_boundary", "approval_scope_ref"],
  "properties": {
    "schema_version": { "const": "0.1" }, "type": { "const": "IntentDelegationEvent" },
    "id": { "$ref": "common.schema.json#/$defs/id" }, "mission_id": { "$ref": "common.schema.json#/$defs/id" },
    "wave_id": { "type": "string", "minLength": 1 },
    "parent_intent_id": { "$ref": "common.schema.json#/$defs/id" }, "child_intent_id": { "$ref": "common.schema.json#/$defs/id" },
    "delegator_agent_id": { "type": "string", "minLength": 1 }, "delegate_agent_id": { "type": "string", "minLength": 1 },
    "delegated_boundary": { "$ref": "intent-continuity-common.schema.json#/$defs/boundary" },
    "approval_scope_ref": { "$ref": "order-adoption-common.schema.json#/$defs/optional_ref" }
  }
}
