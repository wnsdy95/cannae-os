          "type": "string",
          "const": "TaskTrainingStandard"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
        },
        "capability_id": {
          "type": "string",
          "pattern": "^CAP-[A-Za-z0-9_-]+$"
        },
        "metl_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
        },
        "metl_task_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
        },
        "performer_organization_id": {
          "type": "string",
          "pattern": "^ORG-[A-Za-z0-9_-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
