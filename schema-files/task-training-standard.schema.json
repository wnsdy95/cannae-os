          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "minimum_distinct_trials": {
          "type": "integer",
          "minimum": 3,
          "maximum": 16
        },
        "steps": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
              },
              "standard": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "critical": {
                "type": "boolean"
              },
              "evidence_class": {
                "type": "string",
                "enum": [
                  "task_product",
                  "boundary_behavior"
                ]
              },
              "not_applicable_permitted": {
                "type": "boolean"
              }
            },
            "required": [
              "step_id",
              "standard",
              "critical",
              "evidence_class",
              "not_applicable_permitted"
            ],
            "additionalProperties": false
          }
        },
        "cases": {
          "minItems": 3,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
              },
              "stage": {
                "type": "string",
                "enum": [
                  "crawl",
                  "walk"
                ]
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "tool_input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "output_pointer": {
                "type": "string",
                "enum": [
                  "/stdout",
                  "/content"
                ]
              },
              "minimum_output_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65536
              },
              "conditions": {
                "minItems": 1,
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            },
            "required": [
              "case_id",
              "stage",
              "tool_name",
              "tool_input_sha256",
              "output_pointer",
              "minimum_output_bytes",
              "conditions"
            ],
            "additionalProperties": false
          }
        },
        "execution_authorized": {
          "type": "boolean",
          "const": false
        },
        "release_authorized": {
          "type": "boolean",
          "const": false
        },
        "human_final_decision_authority": {
          "type": "string",
          "const": "USER"
        },
        "qualification_granted": {
          "type": "boolean",
          "const": false
        },
        "grant_restoration_authorized": {
          "type": "boolean",
          "const": false
        }
      },
