{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/order-adoption-decision-request.schema.json",
  "title": "OrderAdoptionDecisionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "mission_id",
    "wave_id",
    "type",
    "proposal_ref",
    "backbrief_refs",
    "rehearsal_ref",
    "disposition",
    "decision_ref",
    "execution_authorized",
    "continuation_authorized",
    "release_authorized",
    "human_final_decision_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "mission_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "wave_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "type": {
      "const": "OrderAdoptionDecisionRequest"
    },
    "proposal_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "backbrief_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/artifact_ref"
      }
    },
    "rehearsal_ref": {
      "$ref": "order-adoption-common.schema.json#/$defs/optional_ref"
    },
    "disposition": {
      "enum": [
        "approve",
        "reject",
        "revise"
      ]
    },
    "decision_ref": {
      "$ref": "order-adoption-common.schema.json#/$defs/optional_ref"
    },
    "execution_authorized": {
      "const": false
    },
    "continuation_authorized": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "human_final_decision_authority": {
      "const": "USER"
    }
  }
}
