{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/intent-continuity-common.schema.json",
  "$defs": {
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["green", "amber", "red", "black"],
      "properties": {
        "green": { "$ref": "#/$defs/actions" }, "amber": { "$ref": "#/$defs/actions" },
        "red": { "$ref": "#/$defs/actions" }, "black": { "$ref": "#/$defs/actions" }
      }
    },
    "actions": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "task": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "task_sha256", "owner_agent_id"],
      "properties": {
        "task_id": { "$ref": "common.schema.json#/$defs/id" },
        "task_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "owner_agent_id": { "type": "string", "minLength": 1 }
      }
    },
    "tree": {
      "type": "object", "additionalProperties": false, "required": ["root_intent_id", "intents", "delegations"],
      "properties": {
        "root_intent_id": { "$ref": "common.schema.json#/$defs/id" },
        "intents": { "type": "array", "minItems": 2, "maxItems": 257, "items": { "$ref": "commander-intent.schema.json" } },
        "delegations": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "intent-delegation-event.schema.json" } }
      }
    },
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "agent_id", "plan_sha256", "tree_sha256", "root_intent_id", "lineage", "delegations", "assigned_task"],
      "properties": {
        "schema_version": { "const": "0.1" }, "type": { "const": "AgentIntentAssignment" },
        "agent_id": { "type": "string", "minLength": 1 },
        "plan_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "tree_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "root_intent_id": { "$ref": "common.schema.json#/$defs/id" },
        "lineage": { "type": "array", "minItems": 2, "maxItems": 257, "items": { "$ref": "commander-intent.schema.json" } },
        "delegations": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "intent-delegation-event.schema.json" } },
        "assigned_task": { "$ref": "#/$defs/task" }
      }
    }
  }
}
