{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/github-release-receipt.schema.json",
  "title": "GitHub Release Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "authorization_ref",
    "repository",
    "target",
    "release",
    "release_notes_sha256",
    "authorization_consumed",
    "published",
    "verified",
    "authority",
    "release_authorized",
    "recorded_at",
    "receipt_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1",
        "0.2",
        "0.3",
        "0.4"
      ]
    },
    "type": {
      "type": "string",
      "const": "GitHubReleaseReceipt"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "authorization_ref": {
      "type": "object",
      "required": [
        "authorization_id",
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "authorization_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "full_name",
        "default_branch"
      ],
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "tag_name",
        "release_name",
        "commit_sha",
        "draft",
        "prerelease",
        "latest"
      ],
      "additionalProperties": false,
      "properties": {
        "tag_name": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "release_name": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "draft": {
          "type": "boolean",
          "const": false
        },
        "prerelease": {
          "type": "boolean",
          "const": false
        },
        "latest": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "database_id",
        "node_id",
        "url",
        "api_url",
        "tag_name",
        "target_commitish",
        "resolved_tag_commit_sha",
        "published_at",
        "draft",
        "prerelease",
        "latest"
      ],
      "additionalProperties": false,
      "properties": {
        "database_id": {
          "type": "integer",
          "minimum": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "api_url": {
          "type": "string",
          "format": "uri"
        },
        "tag_name": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "target_commitish": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "resolved_tag_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "draft": {
          "type": "boolean",
          "const": false
        },
        "prerelease": {
          "type": "boolean",
          "const": false
        },
        "latest": {
          "type": "boolean",
          "const": true
        },
        "immutable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "attestation": {
      "type": "object",
      "required": [
        "verification_succeeded",
        "verifier",
        "verified_at",
        "attestation_sha256",
        "bundle_media_type",
        "verification_result_media_type",
        "certificate",
        "verified_timestamps",
        "statement",
        "raw_verification"
      ],
      "additionalProperties": false,
      "properties": {
        "verification_succeeded": {
          "type": "boolean",
          "const": true
        },
        "verifier": {
          "type": "object",
          "required": [
            "tool",
            "version",
            "minimum_version",
            "command",
            "output_format"
          ],
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string",
              "const": "gh"
            },
            "version": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
            },
            "minimum_version": {
              "type": "string",
              "const": "2.93.0"
            },
            "command": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "output_format": {
              "type": "string",
              "const": "json"
            }
          }
        },
        "verified_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "attestation_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "bundle_media_type": {
          "type": "string",
          "const": "application/vnd.dev.sigstore.bundle.v0.3+json"
        },
        "verification_result_media_type": {
          "type": "string",
          "minLength": 1
        },
        "certificate": {
          "type": "object",
          "required": [
            "issuer",
            "subject_alternative_name"
          ],
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "subject_alternative_name": {
              "type": "string",
              "const": "https://dotcom.releases.github.com"
            }
          }
        },
        "verified_timestamps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "uri",
              "timestamp"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "$ref": "common.schema.json#/$defs/timestamp"
              }
            }
          }
        },
        "statement": {
          "type": "object",
          "required": [
            "statement_type",
            "predicate_type",
            "repository",
            "tag_name",
            "package_uri",
            "commit_sha1",
            "asset_subjects"
          ],
          "additionalProperties": false,
          "properties": {
            "statement_type": {
              "type": "string",
              "const": "https://in-toto.io/Statement/v1"
            },
            "predicate_type": {
              "type": "string",
              "const": "https://in-toto.io/attestation/release/v0.2"
            },
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "tag_name": {
              "type": "string",
              "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
            },
            "package_uri": {
              "type": "string",
              "minLength": 1
            },
            "commit_sha1": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "asset_subjects": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "$ref": "common.schema.json#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        "raw_verification": {
          "type": "object"
        }
      }
    },
    "trusted_root": {
      "$ref": "github-release-trusted-root.schema.json"
    },
    "independent_verification": {
      "$ref": "github-release-independent-verification.schema.json"
    },
    "release_notes_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "authorization_consumed": {
      "type": "boolean",
      "const": true
    },
    "published": {
      "type": "boolean",
      "const": true
    },
    "verified": {
      "type": "boolean",
      "const": true
    },
    "authority": {
      "type": "object",
      "required": [
        "human_final_decision_authority",
        "self_approval_prohibited",
        "release_authorized"
      ],
      "additionalProperties": false,
      "properties": {
        "human_final_decision_authority": {
          "type": "string",
          "const": "USER"
        },
        "self_approval_prohibited": {
          "type": "boolean",
          "const": true
        },
        "release_authorized": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "release_authorized": {
      "type": "boolean",
      "const": true
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "receipt_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.2",
              "0.3",
              "0.4"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "release": {
            "required": [
              "immutable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.3",
              "0.4"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "attestation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.4"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "trusted_root",
          "independent_verification"
        ]
      }
    }
  ]
}
