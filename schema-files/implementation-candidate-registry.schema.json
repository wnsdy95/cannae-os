{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/implementation-candidate-registry.schema.json",
  "title": "Implementation Candidate Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "authority",
    "sources",
    "workstreams",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "const": "ImplementationCandidateRegistry"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_final_decision_authority",
        "release_authorized",
        "execution_authorized"
      ],
      "properties": {
        "human_final_decision_authority": {
          "type": "string",
          "const": "USER"
        },
        "release_authorized": {
          "type": "boolean",
          "const": false
        },
        "execution_authorized": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "section_sha256"
        ],
        "properties": {
          "document": {
            "type": "string",
            "minLength": 1
          },
          "section_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "owner_role",
          "completion_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "completion_criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_document",
          "candidate_key",
          "kind",
          "workstream_id",
          "implementation_status",
          "implementation_paths",
          "acceptance_criteria",
          "remaining_work",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IC-[a-f0-9]{16}$"
          },
          "source_document": {
            "type": "string",
            "minLength": 1
          },
          "candidate_key": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "artifact",
              "capability"
            ]
          },
          "workstream_id": {
            "type": "string",
            "minLength": 1
          },
          "implementation_status": {
            "type": "string",
            "enum": [
              "planned",
              "partial",
              "implemented"
            ]
          },
          "implementation_paths": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "requirement",
                "validation_commands"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "validation_commands": {
                  "type": "array",
                  "minItems": 0,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "remaining_work": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
