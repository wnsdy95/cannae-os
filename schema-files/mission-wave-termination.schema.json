{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/mission-wave-termination.schema.json",
  "title": "Mission Wave Termination",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "mission_id",
    "wave_id",
    "status",
    "reason",
    "plan_ref",
    "successor_plan_ref",
    "decision_ref",
    "id",
    "request_sha256",
    "plan_valid_until",
    "retained_artifact_refs",
    "dispatch_settled",
    "execution_completion_claimed",
    "continuation_authorized",
    "release_authorized",
    "terminated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "const": "MissionWaveTermination"
    },
    "mission_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "wave_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "expired",
        "aborted",
        "superseded"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "$ref": "common.schema.json#/$defs/artifact_ref"
    },
    "successor_plan_ref": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/artifact_ref"
        },
        {
          "type": "object",
          "required": [
            "artifact_id",
            "relative_path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "const": "none"
            },
            "relative_path": {
              "const": "none"
            },
            "sha256": {
              "const": "none"
            }
          }
        }
      ]
    },
    "decision_ref": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/artifact_ref"
        },
        {
          "type": "object",
          "required": [
            "artifact_id",
            "relative_path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "const": "none"
            },
            "relative_path": {
              "const": "none"
            },
            "sha256": {
              "const": "none"
            }
          }
        }
      ]
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "request_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "plan_valid_until": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "retained_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/artifact_ref"
      }
    },
    "dispatch_settled": {
      "type": "boolean",
      "const": true
    },
    "execution_completion_claimed": {
      "type": "boolean",
      "const": false
    },
    "continuation_authorized": {
      "type": "boolean",
      "const": false
    },
    "release_authorized": {
      "type": "boolean",
      "const": false
    },
    "terminated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
