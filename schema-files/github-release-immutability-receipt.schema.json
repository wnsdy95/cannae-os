{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/github-release-immutability-receipt.schema.json",
  "title": "GitHub Release Immutability Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "authorization_ref",
    "repository",
    "policy",
    "existing_release_observation",
    "authorization_consumed",
    "policy_change_executed",
    "policy_verified",
    "authority",
    "repository_policy_change_authorized",
    "release_authorized",
    "recorded_at",
    "receipt_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "const": "GitHubReleaseImmutabilityReceipt"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "authorization_ref": {
      "type": "object",
      "required": [
        "authorization_id",
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "authorization_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "full_name",
        "default_branch"
      ],
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "api_version",
        "endpoint",
        "method",
        "operation",
        "before",
        "after",
        "request_performed",
        "response_status",
        "future_releases_only",
        "verified_at"
      ],
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string",
          "const": "2026-03-10"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^/repos/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/immutable-releases$"
        },
        "method": {
          "type": "string",
          "const": "PUT"
        },
        "operation": {
          "type": "string",
          "const": "enable_repository_release_immutability"
        },
        "before": {
          "$ref": "#/$defs/policy_state"
        },
        "after": {
          "$ref": "#/$defs/policy_state_enabled"
        },
        "request_performed": {
          "type": "boolean"
        },
        "response_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "future_releases_only": {
          "type": "boolean",
          "const": true
        },
        "verified_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "existing_release_observation": {
      "type": "object",
      "required": [
        "tag_name",
        "published_at",
        "immutable_before",
        "immutable_after"
      ],
      "additionalProperties": false,
      "properties": {
        "tag_name": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "immutable_before": {
          "type": "boolean"
        },
        "immutable_after": {
          "type": "boolean"
        }
      }
    },
    "authorization_consumed": {
      "type": "boolean",
      "const": true
    },
    "policy_change_executed": {
      "type": "boolean",
      "const": true
    },
    "policy_verified": {
      "type": "boolean",
      "const": true
    },
    "authority": {
      "type": "object",
      "required": [
        "human_final_decision_authority",
        "self_approval_prohibited",
        "repository_policy_change_authorized",
        "release_authorized"
      ],
      "additionalProperties": false,
      "properties": {
        "human_final_decision_authority": {
          "type": "string",
          "const": "USER"
        },
        "self_approval_prohibited": {
          "type": "boolean",
          "const": true
        },
        "repository_policy_change_authorized": {
          "type": "boolean",
          "const": true
        },
        "release_authorized": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "repository_policy_change_authorized": {
      "type": "boolean",
      "const": true
    },
    "release_authorized": {
      "type": "boolean",
      "const": false
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "receipt_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "policy_state": {
      "type": "object",
      "required": [
        "api_version",
        "enabled",
        "enforced_by_owner"
      ],
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string",
          "const": "2026-03-10"
        },
        "enabled": {
          "type": "boolean"
        },
        "enforced_by_owner": {
          "type": "boolean"
        }
      }
    },
    "policy_state_enabled": {
      "type": "object",
      "required": [
        "api_version",
        "enabled",
        "enforced_by_owner"
      ],
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string",
          "const": "2026-03-10"
        },
        "enabled": {
          "type": "boolean",
          "const": true
        },
        "enforced_by_owner": {
          "type": "boolean"
        }
      }
    }
  }
}
