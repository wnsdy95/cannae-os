{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/order-revision-request.schema.json",
  "title": "OrderRevisionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "id", "mission_id", "wave_id", "parent_plan_ref", "parent_adoption_ref", "change_request_ref", "successor_plan", "execution_authorized", "continuation_authorized", "release_authorized", "human_final_decision_authority"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "type": { "const": "OrderRevisionRequest" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "mission_id": { "$ref": "common.schema.json#/$defs/id" },
    "wave_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "parent_plan_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "parent_adoption_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "change_request_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "successor_plan": { "$ref": "mission-wave-plan.schema.json" },
    "execution_authorized": { "const": false },
    "continuation_authorized": { "const": false },
    "release_authorized": { "const": false },
    "human_final_decision_authority": { "const": "USER" }
  }
}
