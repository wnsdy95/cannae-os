{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/source-plan.schema.json",
  "title": "Source Plan",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "mission_id",
    "parent_order",
    "owner",
    "information_requirements",
    "planned_sources",
    "collection_sequence",
    "verification_linkage",
    "gaps",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "type": { "type": "string", "const": "SourcePlan" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "mission_id": { "$ref": "common.schema.json#/$defs/id" },
    "parent_order": { "$ref": "common.schema.json#/$defs/id" },
    "owner": { "$ref": "common.schema.json#/$defs/role_id" },
    "information_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "planned_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "tier", "access_method", "expected_claims"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "$ref": "common.schema.json#/$defs/id" },
          "tier": {
            "type": "string",
            "enum": ["A", "B", "C", "D"]
          },
          "access_method": { "type": "string", "minLength": 1 },
          "expected_claims": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "collection_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "source_id", "action"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "source_id": { "$ref": "common.schema.json#/$defs/id" },
          "action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification_linkage": {
      "type": "object",
      "required": ["verification_plan_id", "linked_check_ids"],
      "additionalProperties": false,
      "properties": {
        "verification_plan_id": { "$ref": "common.schema.json#/$defs/id" },
        "linked_check_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "gaps": { "$ref": "common.schema.json#/$defs/string_list" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
