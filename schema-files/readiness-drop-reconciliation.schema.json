{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/readiness-drop-reconciliation.schema.json",
  "title": "Readiness Drop Reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "id", "observed_at", "repository_key", "initial_manifest_sha256", "results", "registry_complete", "requalification_supported", "execution_authorized", "release_authorized", "human_final_decision_authority"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "type": { "const": "ReadinessDropReconciliation" },
    "id": { "type": "string", "pattern": "^RDR-[a-f0-9]{40}$" },
    "observed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "repository_key": { "type": "string", "minLength": 1 },
    "initial_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "registry_complete": { "const": false },
    "requalification_supported": { "const": false },
    "execution_authorized": { "const": false },
    "release_authorized": { "const": false },
    "human_final_decision_authority": { "const": "USER" },
    "results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lease_ref", "event_refs", "status", "checkpoint_ref"],
        "properties": {
          "lease_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
          "event_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/artifact_ref" } },
          "status": { "enum": ["revoked", "blocked"] },
          "checkpoint_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" }
        }
      }
    }
  }
}
