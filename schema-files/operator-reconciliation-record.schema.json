{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/operator-reconciliation-record.schema.json",
  "title": "OperatorDecisionReconciliationRecord",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "type", "id", "mission_id", "wave_id", "recorded_at", "authorization", "prior_authorization", "cancellation_ref", "observed_manifest", "terminal_state", "signature", "human_final_decision_authority", "execution_authorized", "continuation_authorized", "release_authorized"],
  "properties": {
    "schema_version": { "const": "0.1" }, "type": { "const": "OperatorDecisionReconciliationRecord" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "mission_id": { "$ref": "common.schema.json#/$defs/id" }, "wave_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "recorded_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "authorization": { "$ref": "operator-reconciliation-authorization.schema.json" },
    "prior_authorization": { "oneOf": [{ "type": "null" }, { "$ref": "operator-reconciliation-authorization.schema.json" }] },
    "cancellation_ref": { "$ref": "order-adoption-common.schema.json#/$defs/optional_ref" },
    "observed_manifest": { "$ref": "operator-consent-record.schema.json#/properties/observed_manifest" },
    "terminal_state": { "enum": ["applied", "cancelled"] },
    "signature": { "$ref": "operator-consent-record.schema.json#/properties/signature" },
    "human_final_decision_authority": { "const": "USER" },
    "execution_authorized": { "const": false }, "continuation_authorized": { "const": false }, "release_authorized": { "const": false }
  }
}
