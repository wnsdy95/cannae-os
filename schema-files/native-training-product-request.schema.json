{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "const": "NativeTrainingProductRequest"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
    },
    "collection_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "mission_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
    },
    "wave_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[A-Za-z0-9_-]+$"
    },
    "performer_id": {
      "type": "string",
      "pattern": "^PERF-[A-Za-z0-9_-]+$"
    },
    "registry_head_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "context_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "relative_path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "case_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "release_authorized": {
      "type": "boolean",
      "const": false
    },
    "human_final_decision_authority": {
      "type": "string",
      "const": "USER"
    },
    "qualification_granted": {
      "type": "boolean",
      "const": false
    },
    "grant_restoration_authorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "type",
    "id",
    "collection_id",
    "mission_id",
    "wave_id",
    "capability_id",
    "performer_id",
    "registry_head_ref",
    "context_ref",
    "case_id",
    "classification",
    "created_at",
    "expires_at",
    "execution_authorized",
    "release_authorized",
    "human_final_decision_authority",
    "qualification_granted",
    "grant_restoration_authorized"
  ],
  "additionalProperties": false,
  "$id": "https://controls.local/schema-files/native-training-product-request.schema.json"
}
