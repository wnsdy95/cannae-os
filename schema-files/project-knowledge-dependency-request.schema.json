{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/project-knowledge-dependency-request.schema.json",
  "title": "Project Knowledge Dependency Request",
  "description": "Declared local input dependencies, not proof of completeness, appraisal or authority. Null review_reference is an unreviewed draft.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "type", "work_id", "subject", "previous_sha256", "review_reference", "sources", "terminology", "upstream"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "type": { "const": "ProjectKnowledgeDependencyRequest" },
    "work_id": { "$ref": "#/$defs/work_id" },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["document", "task"],
      "properties": {
        "document": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "task": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 }
      }
    },
    "previous_sha256": { "$ref": "#/$defs/nullable_sha256" },
    "review_reference": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "sources": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256", "required"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "required": { "type": "boolean" }
        }
      }
    },
    "terminology": {
      "anyOf": [ { "type": "null" }, {
        "type": "object", "additionalProperties": false,
        "required": ["ledger_sha256", "domain", "task", "actor", "role", "department", "terms", "required_terms"],
        "properties": {
          "ledger_sha256": { "$ref": "#/$defs/nullable_sha256" },
          "domain": { "type": "string", "minLength": 1, "maxLength": 100 },
          "task": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
          "actor": { "enum": ["user", "ai"] },
          "role": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
          "department": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
          "terms": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/term" } },
          "required_terms": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/term" } }
        }
      } ]
    },
    "upstream": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["work_id", "record_sha256", "required"],
        "properties": {
          "work_id": { "$ref": "#/$defs/work_id" },
          "record_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "required": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "work_id": { "type": "string", "pattern": "^WORK-[A-Z0-9][A-Z0-9_-]*$", "maxLength": 80 },
    "nullable_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "term": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
