{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/degeneration-incident-event.schema.json",
  "title": "Actual Method Drift Revocation Response",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "type", "id", "mission_id", "wave_id", "agent_id", "deny_ref", "lease_ref", "response_checkpoint_ref", "required_response", "response_status", "reason_codes", "recorded_at", "execution_authorized", "continuation_authorized", "release_authorized", "human_final_decision_authority"],
  "properties": {
    "schema_version": { "const": "0.1" }, "type": { "const": "DegenerationIncidentEvent" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "mission_id": { "$ref": "common.schema.json#/$defs/id" },
    "wave_id": { "$ref": "dispatch-tool-policy.schema.json#/$defs/safe_identifier" },
    "agent_id": { "$ref": "dispatch-tool-policy.schema.json#/$defs/safe_identifier" },
    "deny_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "lease_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "response_checkpoint_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "required_response": { "const": "revoke" },
    "response_status": { "enum": ["revoked", "blocked"] },
    "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "recorded_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "execution_authorized": { "const": false }, "continuation_authorized": { "const": false },
    "release_authorized": { "const": false }, "human_final_decision_authority": { "const": "USER" }
  }
}
