{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/oci-linux-sandbox-policy.schema.json",
  "title": "OCI Linux Sandbox Policy",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "repository_binding",
    "gateway_binding_sha256",
    "platform",
    "providers",
    "adapter_profile",
    "image",
    "process_controls",
    "filesystem_controls",
    "seccomp",
    "resource_controls",
    "network_controls",
    "sandbox_profile_sha256",
    "rules",
    "valid_from",
    "expires_at",
    "authority"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "type": { "type": "string", "const": "OciLinuxSandboxPolicy" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "repository_binding": { "$ref": "#/$defs/repository_binding" },
    "gateway_binding_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "platform": {
      "type": "string",
      "const": "linux_oci_docker_reference"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/provider" }
    },
    "adapter_profile": { "$ref": "#/$defs/adapter_profile" },
    "image": { "$ref": "#/$defs/image" },
    "process_controls": { "$ref": "#/$defs/process_controls" },
    "filesystem_controls": { "$ref": "#/$defs/filesystem_controls" },
    "seccomp": { "$ref": "#/$defs/seccomp" },
    "resource_controls": { "$ref": "#/$defs/resource_controls" },
    "network_controls": { "$ref": "#/$defs/network_controls" },
    "sandbox_profile_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/rule" }
    },
    "valid_from": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "authority": { "$ref": "#/$defs/authority" }
  },
  "$defs": {
    "safe_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "provider": {
      "type": "string",
      "enum": ["codex", "claude_code"]
    },
    "repository_binding": {
      "type": "object",
      "required": ["repository_key", "identity_fingerprint"],
      "additionalProperties": false,
      "properties": {
        "repository_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "identity_fingerprint": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "adapter_profile": {
      "type": "object",
      "required": [
        "adapter_id",
        "adapter_version",
        "adapter_sha256",
        "runtime_sha256",
        "probe_sha256",
        "signing_key_id",
        "signing_algorithm",
        "signing_public_key_pem",
        "execution_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "adapter_id": { "$ref": "#/$defs/safe_identifier" },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "adapter_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "runtime_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "probe_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "signing_key_id": { "$ref": "common.schema.json#/$defs/sha256" },
        "signing_algorithm": { "type": "string", "const": "ed25519" },
        "signing_public_key_pem": {
          "type": "string",
          "minLength": 64,
          "maxLength": 8192
        },
        "execution_mode": {
          "type": "string",
          "const": "oci_linux_sandbox_reference"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "image_id",
        "operating_system",
        "architecture",
        "pull_policy",
        "content_trust_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "operating_system": { "type": "string", "const": "linux" },
        "architecture": {
          "type": "string",
          "enum": ["amd64", "arm64"]
        },
        "pull_policy": { "type": "string", "const": "never" },
        "content_trust_verified": { "type": "boolean", "const": false }
      }
    },
    "process_controls": {
      "type": "object",
      "required": [
        "shell",
        "detached",
        "environment_mode",
        "stdin_mode",
        "uid",
        "gid",
        "cap_drop",
        "no_new_privileges",
        "init",
        "pid_namespace",
        "ipc_namespace",
        "uts_namespace",
        "cgroup_namespace"
      ],
      "additionalProperties": false,
      "properties": {
        "shell": { "type": "boolean", "const": false },
        "detached": { "type": "boolean", "const": false },
        "environment_mode": { "type": "string", "const": "empty" },
        "stdin_mode": { "type": "string", "const": "none" },
        "uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967294
        },
        "gid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967294
        },
        "cap_drop": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "ALL" }
        },
        "no_new_privileges": { "type": "boolean", "const": true },
        "init": { "type": "boolean", "const": true },
        "pid_namespace": { "type": "string", "const": "private" },
        "ipc_namespace": { "type": "string", "const": "private" },
        "uts_namespace": { "type": "string", "const": "private" },
        "cgroup_namespace": { "type": "string", "const": "private" }
      }
    },
    "filesystem_controls": {
      "type": "object",
      "required": [
        "read_only_rootfs",
        "repository_destination",
        "repository_read_only",
        "recursive_read_only_required",
        "tmpfs_destination",
        "tmpfs_size_bytes",
        "tmpfs_options"
      ],
      "additionalProperties": false,
      "properties": {
        "read_only_rootfs": { "type": "boolean", "const": true },
        "repository_destination": {
          "type": "string",
          "const": "/workspace"
        },
        "repository_read_only": { "type": "boolean", "const": true },
        "recursive_read_only_required": { "type": "boolean", "const": true },
        "tmpfs_destination": { "type": "string", "const": "/tmp" },
        "tmpfs_size_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1073741824
        },
        "tmpfs_options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["rw", "noexec", "nosuid", "nodev"]
          }
        }
      }
    },
    "seccomp": {
      "type": "object",
      "required": [
        "profile_name",
        "source_uri",
        "source_commit",
        "profile_relative_path",
        "profile_sha256",
        "default_action"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_uri": { "type": "string", "format": "uri" },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "profile_relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "profile_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "default_action": { "type": "string", "const": "SCMP_ACT_ERRNO" }
      }
    },
    "resource_controls": {
      "type": "object",
      "required": [
        "memory_bytes",
        "memory_swap_bytes",
        "pids_limit",
        "cpu_period_us",
        "cpu_quota_us"
      ],
      "additionalProperties": false,
      "properties": {
        "memory_bytes": {
          "type": "integer",
          "minimum": 67108864,
          "maximum": 4294967296
        },
        "memory_swap_bytes": {
          "type": "integer",
          "minimum": 67108864,
          "maximum": 4294967296
        },
        "pids_limit": {
          "type": "integer",
          "minimum": 8,
          "maximum": 4096
        },
        "cpu_period_us": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "cpu_quota_us": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        }
      }
    },
    "network_controls": {
      "type": "object",
      "required": [
        "mode",
        "outbound",
        "allowed_interfaces",
        "dns",
        "proxy_environment",
        "network_policy_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "const": "none" },
        "outbound": { "type": "string", "const": "prohibited" },
        "allowed_interfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "const": "lo" }
        },
        "dns": { "type": "string", "const": "none" },
        "proxy_environment": { "type": "string", "const": "prohibited" },
        "network_policy_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "rule_id",
        "tool_name",
        "operation_class",
        "executable_path",
        "executable_format",
        "executable_sha256",
        "argv",
        "cwd",
        "timeout_ms",
        "max_stdout_bytes",
        "max_stderr_bytes",
        "success_exit_codes",
        "expected_repository_effect"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "$ref": "#/$defs/safe_identifier" },
        "tool_name": { "$ref": "#/$defs/safe_identifier" },
        "operation_class": {
          "type": "string",
          "const": "process_execute"
        },
        "executable_path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "executable_format": {
          "type": "string",
          "const": "static_linux_binary"
        },
        "executable_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "argv": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "cwd": { "type": "string", "const": "/workspace" },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "max_stdout_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_stderr_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "success_exit_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "expected_repository_effect": { "type": "string", "const": "none" }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "human_final_decision_authority",
        "self_approval_prohibited",
        "production_execution_authorized",
        "release_authorized"
      ],
      "additionalProperties": false,
      "properties": {
        "human_final_decision_authority": {
          "type": "string",
          "const": "USER"
        },
        "self_approval_prohibited": { "type": "boolean", "const": true },
        "production_execution_authorized": {
          "type": "boolean",
          "const": false
        },
        "release_authorized": { "type": "boolean", "const": false }
      }
    }
  }
}
