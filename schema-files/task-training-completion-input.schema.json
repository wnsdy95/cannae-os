{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "const": "TaskTrainingCompletionInput"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
    },
    "hook_input": {
      "type": "object",
      "properties": {
        "hook_event_name": {
          "type": "string",
          "enum": [
            "PostToolUse",
            "PostToolUseFailure"
          ]
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tool_use_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tool_input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "tool_response": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "hook_event_name",
        "tool_name",
        "tool_use_id",
        "tool_input",
        "tool_response"
      ],
      "additionalProperties": false
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "release_authorized": {
      "type": "boolean",
      "const": false
    },
    "human_final_decision_authority": {
      "type": "string",
      "const": "USER"
    },
    "qualification_granted": {
      "type": "boolean",
      "const": false
    },
    "grant_restoration_authorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "type",
    "id",
    "hook_input",
    "execution_authorized",
    "release_authorized",
    "human_final_decision_authority",
    "qualification_granted",
    "grant_restoration_authorized"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  },
  "$id": "https://controls.local/schema-files/task-training-completion-input.schema.json"
}
