{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/github-release-integrity-observation.schema.json",
  "title": "GitHub Release Integrity Observation",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "scope",
    "policy_ref",
    "repository",
    "trigger",
    "policy_observation",
    "releases",
    "issues",
    "summary",
    "authority",
    "repository_policy_change_authorized",
    "release_authorized",
    "observed_at",
    "observation_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ]
    },
    "type": {
      "type": "string",
      "const": "GitHubReleaseIntegrityObservation"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "scope": {
      "type": "string",
      "enum": [
        "full",
        "release_attestation"
      ]
    },
    "policy_ref": {
      "type": "object",
      "required": [
        "policy_id",
        "relative_path",
        "sha256",
        "head_blob_sha256",
        "committed_at_head"
      ],
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "head_blob_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "committed_at_head": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "full_name",
        "default_branch",
        "visibility",
        "branch",
        "observed_head_sha",
        "origin_default_branch_sha",
        "clean"
      ],
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "const": "PUBLIC"
        },
        "branch": {
          "type": "string"
        },
        "observed_head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "origin_default_branch_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "clean": {
          "type": "boolean"
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "kind",
        "actor",
        "run_id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "manual",
            "schedule",
            "release",
            "push"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy_observation": {
      "type": "object",
      "required": [
        "api_version",
        "endpoint",
        "status",
        "checked_at"
      ],
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string",
          "const": "2026-03-10"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^/repos/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/immutable-releases$"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "not_requested",
            "credential_unavailable",
            "inspection_failed"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "enforced_by_owner": {
          "type": "boolean"
        },
        "checked_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "trusted_root_observation": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unavailable"
          ]
        },
        "artifact": {
          "$ref": "github-release-trusted-root.schema.json"
        },
        "failure_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust_checkpoint_observation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "provenance",
            "previous_checkpoint",
            "previous_trusted_root",
            "current_checkpoint"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "const": "verified"
            },
            "provenance": {
              "$ref": "#/$defs/checkpointProvenance"
            },
            "previous_checkpoint": {
              "$ref": "github-release-trust-checkpoint.schema.json"
            },
            "previous_trusted_root": {
              "$ref": "github-release-trusted-root.schema.json"
            },
            "current_checkpoint": {
              "$ref": "github-release-trust-checkpoint.schema.json"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "failure_code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "failure_code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "releases": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "tag_name",
          "release_name",
          "commit_sha",
          "published_at",
          "draft",
          "prerelease",
          "latest",
          "immutable",
          "classification",
          "attestation"
        ],
        "additionalProperties": false,
        "properties": {
          "tag_name": {
            "type": "string",
            "minLength": 1
          },
          "release_name": {
            "type": "string",
            "minLength": 1
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "published_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "draft": {
            "type": "boolean"
          },
          "prerelease": {
            "type": "boolean"
          },
          "latest": {
            "type": "boolean"
          },
          "immutable": {
            "type": "boolean"
          },
          "classification": {
            "type": "string",
            "enum": [
              "grandfathered",
              "post_activation"
            ]
          },
          "attestation": {
            "type": "object",
            "required": [
              "required",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "not_required",
                  "failed"
                ]
              },
              "failure_code": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "object"
              },
              "independent_verification": {
                "$ref": "github-release-independent-verification.schema.json"
              }
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "scope",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "error"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "repository",
              "policy",
              "release",
              "attestation",
              "checkpoint"
            ]
          },
          "tag_name": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "status",
        "monitoring_complete",
        "policy_assessment_complete",
        "policy_drift_assessed",
        "policy_drift_detected",
        "release_integrity_assessed",
        "release_count",
        "grandfathered_count",
        "post_activation_count",
        "required_attestation_count",
        "verified_attestation_count",
        "issue_count"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "monitoring_complete": {
          "type": "boolean"
        },
        "policy_assessment_complete": {
          "type": "boolean"
        },
        "policy_drift_assessed": {
          "type": "boolean"
        },
        "policy_drift_detected": {
          "type": "boolean"
        },
        "release_integrity_assessed": {
          "type": "boolean"
        },
        "release_count": {
          "type": "integer",
          "minimum": 0
        },
        "grandfathered_count": {
          "type": "integer",
          "minimum": 0
        },
        "post_activation_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_attestation_count": {
          "type": "integer",
          "minimum": 0
        },
        "verified_attestation_count": {
          "type": "integer",
          "minimum": 0
        },
        "independently_verified_attestation_count": {
          "type": "integer",
          "minimum": 0
        },
        "trust_checkpoint_continuity_verified": {
          "type": "boolean"
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "human_final_decision_authority",
        "self_approval_prohibited",
        "monitoring_only",
        "repository_policy_change_authorized",
        "release_authorized"
      ],
      "additionalProperties": false,
      "properties": {
        "human_final_decision_authority": {
          "type": "string",
          "const": "USER"
        },
        "self_approval_prohibited": {
          "type": "boolean",
          "const": true
        },
        "monitoring_only": {
          "type": "boolean",
          "const": true
        },
        "repository_policy_change_authorized": {
          "type": "boolean",
          "const": false
        },
        "release_authorized": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "repository_policy_change_authorized": {
      "type": "boolean",
      "const": false
    },
    "release_authorized": {
      "type": "boolean",
      "const": false
    },
    "observed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "observation_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.2",
              "0.3"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "trusted_root_observation"
        ],
        "properties": {
          "summary": {
            "required": [
              "independently_verified_attestation_count"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.3"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "trust_checkpoint_observation"
        ],
        "properties": {
          "summary": {
            "required": [
              "trust_checkpoint_continuity_verified"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "checkpointProvenance": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source",
            "policy_introduction_commit",
            "policy_introduction_time",
            "bootstrap_checkpoint_path",
            "bootstrap_checkpoint_sha256",
            "bootstrap_trusted_root_path",
            "bootstrap_trusted_root_sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "const": "repository_bootstrap"
            },
            "policy_introduction_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "policy_introduction_time": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "bootstrap_checkpoint_path": {
              "type": "string",
              "const": ".github/tuf/github-release-trust-checkpoint.json"
            },
            "bootstrap_checkpoint_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bootstrap_trusted_root_path": {
              "type": "string",
              "const": ".github/tuf/github-release-trust-bootstrap-root.json"
            },
            "bootstrap_trusted_root_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source",
            "policy_introduction_commit",
            "policy_introduction_time",
            "bootstrap_checkpoint_path",
            "bootstrap_checkpoint_sha256",
            "bootstrap_trusted_root_path",
            "bootstrap_trusted_root_sha256",
            "recovery_authorization_path",
            "recovery_authorization_sha256",
            "recovery_grant_id",
            "blocked_run_count"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "const": "repository_bootstrap_recovery"
            },
            "policy_introduction_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "policy_introduction_time": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "bootstrap_checkpoint_path": {
              "type": "string",
              "const": ".github/tuf/github-release-trust-checkpoint.json"
            },
            "bootstrap_checkpoint_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "bootstrap_trusted_root_path": {
              "type": "string",
              "const": ".github/tuf/github-release-trust-bootstrap-root.json"
            },
            "bootstrap_trusted_root_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "recovery_authorization_path": {
              "type": "string",
              "const": ".github/tuf/github-release-bootstrap-recovery.json"
            },
            "recovery_authorization_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "recovery_grant_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "blocked_run_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source",
            "run_id",
            "run_attempt",
            "head_sha",
            "conclusion",
            "artifact_id",
            "artifact_name",
            "artifact_digest",
            "artifact_created_at",
            "artifact_expires_at"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "const": "github_actions_artifact"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "conclusion": {
              "type": "string",
              "enum": [
                "success",
                "failure"
              ]
            },
            "artifact_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "artifact_name": {
              "type": "string",
              "minLength": 1
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "artifact_created_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "artifact_expires_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          }
        }
      ]
    }
  }
}
