{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "const": "OperatorModelReconciliationAuthorization"
    },
    "id": {
      "type": "string",
      "pattern": "^OMRA-[a-f0-9-]{36}$"
    },
    "reconciliation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "action_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "purpose": {
      "type": "string",
      "const": "acknowledge_one_failed_model_transfer"
    },
    "resolution": {
      "type": "string",
      "const": "acknowledge_failed_transfer"
    },
    "principal_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "principal_epoch": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "authentication_method": {
      "type": "string",
      "const": "local_owner_password_reauthentication"
    },
    "session_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonce_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "repository_binding": {
          "type": "object",
          "properties": {
            "repository_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "identity_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "repository_key",
            "identity_fingerprint"
          ],
          "additionalProperties": false
        },
        "original_action_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "invocation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "consent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "journal_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prior_attempts_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository_state_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trusted_key_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "process_id": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "child_exit_recorded": {
          "type": "boolean",
          "const": true
        },
        "child_absence_observed": {
          "type": "boolean",
          "const": true
        },
        "process_group_absence_observed": {
          "type": "boolean",
          "const": true
        },
        "failure_reasons": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?:SEMANTIC|CONSOLE)_[A-Z0-9_]+$"
          }
        },
        "transfer_effects": {
          "type": "string",
          "const": "possibly_transmitted"
        },
        "provider_billing_verified": {
          "type": "boolean",
          "const": false
        },
        "provider_cancellation_verified": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "action_id",
        "repository_binding",
        "original_action_sha256",
        "invocation_sha256",
        "consent_sha256",
        "result_sha256",
        "journal_sha256",
        "prior_attempts_sha256",
        "manifest_sha256",
        "repository_state_sha256",
        "runtime_source_sha256",
        "trusted_key_sha256",
        "process_id",
        "observed_at",
        "child_exit_recorded",
        "child_absence_observed",
        "process_group_absence_observed",
        "failure_reasons",
        "transfer_effects",
        "provider_billing_verified",
        "provider_cancellation_verified"
      ],
      "additionalProperties": false
    },
    "provider_uncertainty_acknowledged": {
      "type": "boolean",
      "const": true
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "release_authorized": {
      "type": "boolean",
      "const": false
    },
    "human_final_decision_authority": {
      "type": "string",
      "const": "USER"
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "key_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "algorithm",
        "key_sha256",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "type",
    "id",
    "reconciliation_id",
    "action_id",
    "sequence",
    "purpose",
    "resolution",
    "principal_id",
    "principal_epoch",
    "authentication_method",
    "session_sha256",
    "nonce_sha256",
    "rationale",
    "created_at",
    "expires_at",
    "subject",
    "provider_uncertainty_acknowledged",
    "execution_authorized",
    "release_authorized",
    "human_final_decision_authority",
    "signature"
  ],
  "additionalProperties": false,
  "$id": "operator-model-reconciliation-authorization.schema.json",
  "title": "Non-authorizing OperatorModelReconciliationAuthorization"
}
