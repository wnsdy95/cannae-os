{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/order-adoption-proposal-request.schema.json",
  "title": "OrderAdoptionProposalRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "mission_id",
    "wave_id",
    "type",
    "plan",
    "execution_authorized",
    "continuation_authorized",
    "release_authorized",
    "human_final_decision_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "mission_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "wave_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "type": {
      "const": "OrderAdoptionProposalRequest"
    },
    "plan": {
      "$ref": "mission-wave-plan.schema.json"
    },
    "execution_authorized": {
      "const": false
    },
    "continuation_authorized": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "human_final_decision_authority": {
      "const": "USER"
    }
  }
}
