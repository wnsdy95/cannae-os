{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/oci-sandbox-containment-observation.schema.json",
  "title": "OCI Sandbox Containment Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "id", "transaction_id", "mission_id", "wave_id", "agent_id", "provider", "repository_binding", "request_ref", "decision_ref", "execution_event_ref", "terminal_event_ref", "sandbox_policy_ref", "execution_envelope_ref", "tool_input_sha256", "container_name", "daemon_id_sha256", "docker_cli_sha256", "absence_argv_sha256", "listing_sha256", "listing_row_count", "started_at", "observed_at", "expires_at", "verification_method", "daemon_identity_assurance", "container_absent", "effects_settled", "tool_execution_authorized", "release_authorized", "signature", "observation_sha256"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "type": { "const": "OciSandboxContainmentObservation" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "transaction_id": { "$ref": "common.schema.json#/$defs/id" },
    "mission_id": { "$ref": "common.schema.json#/$defs/id" },
    "wave_id": { "$ref": "oci-sandbox-execution-envelope.schema.json#/$defs/safe_identifier" },
    "agent_id": { "$ref": "oci-sandbox-execution-envelope.schema.json#/$defs/safe_identifier" },
    "provider": { "$ref": "oci-sandbox-execution-envelope.schema.json#/$defs/provider" },
    "repository_binding": { "$ref": "oci-sandbox-execution-envelope.schema.json#/$defs/repository_binding" },
    "request_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "decision_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "execution_event_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "terminal_event_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "sandbox_policy_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "execution_envelope_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
    "tool_input_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "container_name": { "type": "string", "pattern": "^cannae-[a-f0-9]{24}$" },
    "daemon_id_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "docker_cli_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "absence_argv_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "listing_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "listing_row_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "observed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "verification_method": { "const": "docker_all_states_exact_name" },
    "daemon_identity_assurance": { "const": "provider_observed_not_attested" },
    "container_absent": { "const": true },
    "effects_settled": { "const": false },
    "tool_execution_authorized": { "const": false },
    "release_authorized": { "const": false },
    "signature": { "$ref": "oci-sandbox-execution-envelope.schema.json#/$defs/signature" },
    "observation_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
