{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/force-registry-request.schema.json",
  "title": "Non-authorizing Force Definition Change Request",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "type", "id", "purpose", "mission_id", "wave_id", "operation", "expected_head_ref", "entity", "rationale", "evidence_refs", "execution_authorized", "release_authorized", "human_final_decision_authority", "qualification_granted", "standing_activation_authorized"],
  "properties": {
    "schema_version": { "const": "0.1" }, "type": { "const": "ForceRegistryRequest" }, "id": { "$ref": "common.schema.json#/$defs/id" }, "purpose": { "const": "force_registry_enrollment" },
    "mission_id": { "$ref": "common.schema.json#/$defs/id" }, "wave_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 },
    "operation": { "enum": ["enroll", "revise", "retire"] }, "expected_head_ref": { "$ref": "#/$defs/reference_or_none" }, "entity": { "$ref": "force-registry-entity.schema.json" },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }, "evidence_refs": { "type": "array", "maxItems": 16, "items": { "$ref": "common.schema.json#/$defs/artifact_ref" } },
    "execution_authorized": { "const": false }, "release_authorized": { "const": false }, "human_final_decision_authority": { "const": "USER" },
    "qualification_granted": { "const": false }, "standing_activation_authorized": { "const": false }
  },
  "$defs": { "reference_or_none": { "anyOf": [{ "$ref": "common.schema.json#/$defs/artifact_ref" }, {
    "type": "object", "additionalProperties": false, "required": ["artifact_id", "relative_path", "sha256"],
    "properties": { "artifact_id": { "const": "none" }, "relative_path": { "const": "none" }, "sha256": { "const": "none" } }
  }] } }
}
