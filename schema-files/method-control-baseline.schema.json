{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/method-control-baseline.schema.json",
  "title": "Reviewed Exact-Input Method Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "required", "after_report_due", "max_deviation_age_seconds", "agents"],
  "properties": {
    "schema_version": { "enum": ["0.1", "0.2"] },
    "broker": { "$ref": "method-control-channel-policy.schema.json" },
    "type": { "const": "MethodControlBaseline" },
    "required": { "const": true },
    "after_report_due": { "const": "before_next_tool_or_completion" },
    "max_deviation_age_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
    "agents": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["agent_id", "task_id", "task_sha256", "steps"],
        "properties": {
          "agent_id": { "$ref": "dispatch-tool-policy.schema.json#/$defs/safe_identifier" },
          "task_id": { "$ref": "common.schema.json#/$defs/id" },
          "task_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "steps": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/step" } }
        }
      }
    }
  },
  "$defs": {
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "control_channel", "plan_sha256", "baseline_sha256", "baseline", "after_report_due", "max_deviation_age_seconds"],
      "properties": {
        "schema_version": { "enum": ["0.1", "0.2"] }, "type": { "const": "AgentMethodAssignment" },
        "control_channel": { "enum": ["trusted_operator_control_plane", "enrolled_mcp_stdio_reference"] },
        "broker": { "$ref": "#/$defs/broker_assignment" },
        "plan_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "baseline_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "baseline": { "$ref": "#/properties/agents/items" },
        "after_report_due": { "const": "before_next_tool_or_completion" },
        "max_deviation_age_seconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "broker_assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "type", "transport", "identity_assurance", "runtime_sha256", "max_requests", "max_validity_seconds", "request_validity_seconds", "output_max_bytes", "server_name", "operations"],
      "properties": {
        "schema_version": { "$ref": "method-control-channel-policy.schema.json#/properties/schema_version" }, "type": { "const": "MethodControlChannelPolicy" },
        "transport": { "const": "mcp_stdio_reference" }, "identity_assurance": { "const": "local_operator_enrollment_reference" },
        "runtime_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "max_requests": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_validity_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "request_validity_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "output_max_bytes": { "type": "integer", "minimum": 4096, "maximum": 262144 },
        "continuation": { "$ref": "method-control-channel-policy.schema.json#/properties/continuation" },
        "server_name": { "$ref": "dispatch-tool-policy.schema.json#/$defs/safe_identifier" },
        "operations": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "enum": ["method_status", "method_propose", "method_report_after"] } }
      },
      "allOf": [{ "$ref": "method-control-channel-policy.schema.json#/allOf/0" }]
    },
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_name", "rule_id", "input_sha256", "instructions"],
      "properties": {
        "tool_name": { "$ref": "dispatch-tool-policy.schema.json#/$defs/tool_name" },
        "rule_id": { "$ref": "dispatch-tool-policy.schema.json#/$defs/rule_id" },
        "input_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "alternative": {
      "type": "object", "additionalProperties": false,
      "required": ["method_id", "tool_name", "rule_id", "input_sha256", "instructions", "report_timing"],
      "properties": {
        "method_id": { "$ref": "dispatch-tool-policy.schema.json#/$defs/safe_identifier" },
        "tool_name": { "$ref": "dispatch-tool-policy.schema.json#/$defs/tool_name" },
        "rule_id": { "$ref": "dispatch-tool-policy.schema.json#/$defs/rule_id" },
        "input_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "report_timing": { "enum": ["after", "before_and_after"] }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "kind", "mission_action", "planned", "alternatives"],
      "properties": {
        "step_id": { "$ref": "dispatch-tool-policy.schema.json#/$defs/safe_identifier" },
        "kind": { "enum": ["work", "safeguard"] },
        "mission_action": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "planned": { "$ref": "#/$defs/method" },
        "alternatives": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/alternative" } }
      }
    }
  }
}
