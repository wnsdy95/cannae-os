{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/gateway-effect-scope.schema.json",
  "title": "Gateway Effect Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "id",
    "mission_id",
    "wave_id",
    "agent_id",
    "repository_binding",
    "subject",
    "expected_repository_state",
    "coverage_statement",
    "resources",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "type": {
      "const": "GatewayEffectScope"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "mission_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "wave_id": {
      "$ref": "agent-execution-checkpoint.schema.json#/$defs/safe_identifier"
    },
    "agent_id": {
      "$ref": "agent-execution-checkpoint.schema.json#/$defs/safe_identifier"
    },
    "repository_binding": {
      "$ref": "verification-plan.schema.json#/properties/repository_binding"
    },
    "subject": {
      "$ref": "gateway-effect-subject.schema.json"
    },
    "expected_repository_state": {
      "$ref": "verification-plan.schema.json#/properties/expected_repository_state"
    },
    "coverage_statement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4096
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "boundary",
          "target",
          "disposition",
          "evidence_refs",
          "check_ids"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "boundary": {
            "$ref": "gateway-effect-subject.schema.json#/$defs/boundary"
          },
          "target": {
            "$ref": "tool-effect-scope.schema.json#/properties/resources/items/properties/target"
          },
          "disposition": {
            "$ref": "tool-effect-scope.schema.json#/properties/resources/items/properties/disposition"
          },
          "evidence_refs": {
            "$ref": "tool-effect-scope.schema.json#/properties/resources/items/properties/evidence_refs"
          },
          "check_ids": {
            "$ref": "tool-effect-scope.schema.json#/properties/resources/items/properties/check_ids"
          }
        }
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
