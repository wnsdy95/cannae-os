{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/decision-log.schema.json",
  "title": "Decision Log Entry",
  "type": "object",
  "required": ["schema_version", "type", "id", "mission_id", "decided_at", "decision_maker", "decision_type", "question", "options_considered", "chosen_option", "rationale", "authority_basis", "affected_artifacts", "review_trigger", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "type": { "type": "string", "const": "DecisionLogEntry" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "mission_id": { "$ref": "common.schema.json#/$defs/id" },
    "decided_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "decision_maker": { "$ref": "common.schema.json#/$defs/role_id" },
    "decision_type": {
      "type": "string",
      "enum": ["priority", "approval", "scope", "risk_acceptance", "doctrine_update", "release"]
    },
    "question": { "type": "string", "minLength": 1 },
    "options_considered": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "chosen_option": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "authority_basis": {
      "type": "object",
      "required": ["basis_type", "reference", "summary"],
      "additionalProperties": false,
      "properties": {
        "basis_type": {
          "type": "string",
          "enum": ["approval_scope", "board_decision", "retained_authority"]
        },
        "reference": { "$ref": "common.schema.json#/$defs/id" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "affected_artifacts": { "$ref": "common.schema.json#/$defs/string_list" },
    "review_trigger": { "type": "string", "minLength": 1 },
    "status": { "$ref": "common.schema.json#/$defs/status" }
  }
}
