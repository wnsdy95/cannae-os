{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/github-release-authorization.schema.json",
  "title": "GitHub Release Authorization",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "issued_at",
    "expires_at",
    "single_use",
    "consumed",
    "repository",
    "target",
    "previous_release",
    "release_notes",
    "main_validation",
    "repository_state",
    "release_review",
    "user_grant",
    "authority",
    "release_authorized",
    "authorization_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "const": "GitHubReleaseAuthorization"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "single_use": {
      "type": "boolean",
      "const": true
    },
    "consumed": {
      "type": "boolean",
      "const": false
    },
    "repository": {
      "type": "object",
      "required": [
        "full_name",
        "origin_full_name",
        "default_branch",
        "visibility",
        "viewer_permission"
      ],
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "origin_full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "const": "PUBLIC"
        },
        "viewer_permission": {
          "type": "string",
          "enum": [
            "ADMIN",
            "MAINTAIN",
            "WRITE"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "tag_name",
        "release_name",
        "commit_sha",
        "draft",
        "prerelease",
        "latest",
        "fail_on_no_commits"
      ],
      "additionalProperties": false,
      "properties": {
        "tag_name": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "release_name": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "draft": {
          "type": "boolean",
          "const": false
        },
        "prerelease": {
          "type": "boolean",
          "const": false
        },
        "latest": {
          "type": "boolean",
          "const": true
        },
        "fail_on_no_commits": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "previous_release": {
      "type": "object",
      "required": [
        "tag_name",
        "commit_sha",
        "published_at"
      ],
      "additionalProperties": false,
      "properties": {
        "tag_name": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "release_notes": {
      "type": "object",
      "required": [
        "relative_path",
        "sha256",
        "byte_length"
      ],
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "main_validation": {
      "type": "object",
      "required": [
        "workflow_name",
        "required_check",
        "required_check_job_id",
        "required_check_job_url",
        "required_check_status",
        "required_check_conclusion",
        "run_id",
        "run_url",
        "event",
        "status",
        "conclusion",
        "head_branch",
        "head_sha"
      ],
      "additionalProperties": false,
      "properties": {
        "workflow_name": {
          "type": "string",
          "const": "Validate"
        },
        "required_check": {
          "type": "string",
          "const": "Doctrine and runtime checks"
        },
        "required_check_job_id": {
          "type": "integer",
          "minimum": 1
        },
        "required_check_job_url": {
          "type": "string",
          "format": "uri"
        },
        "required_check_status": {
          "type": "string",
          "const": "completed"
        },
        "required_check_conclusion": {
          "type": "string",
          "const": "success"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_url": {
          "type": "string",
          "format": "uri"
        },
        "event": {
          "type": "string",
          "const": "push"
        },
        "status": {
          "type": "string",
          "const": "completed"
        },
        "conclusion": {
          "type": "string",
          "const": "success"
        },
        "head_branch": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "repository_state": {
      "type": "object",
      "required": [
        "branch",
        "head_sha",
        "origin_default_branch_sha",
        "clean",
        "tag_absent",
        "release_absent"
      ],
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "origin_default_branch_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "clean": {
          "type": "boolean",
          "const": true
        },
        "tag_absent": {
          "type": "boolean",
          "const": true
        },
        "release_absent": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "release_review": {
      "type": "object",
      "required": [
        "reviewed_by",
        "decision",
        "repository_visibility",
        "target_was_already_public",
        "reviewed_commit_sha",
        "reviewed_release_notes_sha256",
        "reviewed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewed_by": {
          "type": "string",
          "const": "USER"
        },
        "decision": {
          "type": "string",
          "const": "approve"
        },
        "repository_visibility": {
          "type": "string",
          "const": "PUBLIC"
        },
        "target_was_already_public": {
          "type": "boolean",
          "const": true
        },
        "reviewed_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "reviewed_release_notes_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "reviewed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "user_grant": {
      "type": "object",
      "required": [
        "grant_id",
        "authority",
        "scope",
        "repository",
        "tag_name",
        "target_commit_sha",
        "release_notes_sha256",
        "approved",
        "granted_at",
        "expires_at",
        "directive_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "grant_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "authority": {
          "type": "string",
          "const": "USER"
        },
        "scope": {
          "type": "string",
          "const": "single_github_release"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "tag_name": {
          "type": "string",
          "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "target_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "release_notes_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "approved": {
          "type": "boolean",
          "const": true
        },
        "granted_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "directive_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "human_final_decision_authority",
        "self_approval_prohibited",
        "ai_approval_accepted",
        "release_authorized"
      ],
      "additionalProperties": false,
      "properties": {
        "human_final_decision_authority": {
          "type": "string",
          "const": "USER"
        },
        "self_approval_prohibited": {
          "type": "boolean",
          "const": true
        },
        "ai_approval_accepted": {
          "type": "boolean",
          "const": false
        },
        "release_authorized": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "release_authorized": {
      "type": "boolean",
      "const": true
    },
    "authorization_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
