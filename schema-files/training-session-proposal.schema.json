{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "type": {
      "type": "string",
      "const": "TaskTrainingSessionProposal"
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
    },
    "purpose": {
      "type": "string",
      "const": "task_training_session_enrollment"
    },
    "request": {
      "type": "object",
      "properties": {
        "mission_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
        },
        "wave_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capability_id": {
          "type": "string",
          "pattern": "^CAP-[A-Za-z0-9_-]+$"
        },
        "performer_id": {
          "type": "string",
          "pattern": "^PERF-[A-Za-z0-9_-]+$"
        },
        "expected_registry_head_ref": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
            },
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifact_id",
            "relative_path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "lease_ref": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
            },
            "relative_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifact_id",
            "relative_path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "stage": {
          "type": "string",
          "enum": [
            "crawl",
            "walk"
          ]
        },
        "case_ids": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Z]+-[A-Za-z0-9_-]+$"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "mission_id",
        "wave_id",
        "capability_id",
        "performer_id",
        "expected_registry_head_ref",
        "lease_ref",
        "stage",
        "case_ids",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "release_authorized": {
      "type": "boolean",
      "const": false
    },
    "human_final_decision_authority": {
      "type": "string",
      "const": "USER"
    },
    "qualification_granted": {
      "type": "boolean",
      "const": false
    },
    "grant_restoration_authorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "type",
    "id",
    "purpose",
    "request",
    "created_at",
    "expires_at",
    "execution_authorized",
    "release_authorized",
    "human_final_decision_authority",
    "qualification_granted",
    "grant_restoration_authorized"
  ],
  "additionalProperties": false,
  "$id": "https://controls.local/schema-files/training-session-proposal.schema.json"
}
