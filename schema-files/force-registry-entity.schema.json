{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controls.local/schema-files/force-registry-entity.schema.json",
  "title": "Versioned Unqualified Force Registry Definition",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "type", "id", "kind", "version", "enrollment_state", "label", "description", "data", "qualification_state", "execution_authorized", "release_authorized"],
  "allOf": [
    { "if": { "properties": { "kind": { "const": "organization" } } }, "then": { "properties": { "data": { "properties": { "kind": { "const": "organization" } } } } } },
    { "if": { "properties": { "kind": { "const": "capability" } } }, "then": { "properties": { "data": { "properties": { "kind": { "const": "capability" } } } } } },
    { "if": { "properties": { "kind": { "const": "performer" } } }, "then": { "properties": { "data": { "properties": { "kind": { "const": "performer" } } } } } }
  ],
  "properties": {
    "schema_version": { "const": "0.1" }, "type": { "const": "ForceRegistryEntity" }, "id": { "$ref": "common.schema.json#/$defs/id" },
    "kind": { "enum": ["organization", "capability", "performer"] }, "version": { "type": "integer", "minimum": 1 },
    "enrollment_state": { "enum": ["enrolled", "retired"] }, "label": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "qualification_state": { "const": "unassessed" }, "execution_authorized": { "const": false }, "release_authorized": { "const": false },
    "data": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "parent_id", "maintainer_roles"], "properties": {
        "kind": { "const": "organization" }, "parent_id": { "type": "string", "pattern": "^(none|ORG-[A-Za-z0-9_-]+)$" },
        "maintainer_roles": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/role_id" } }
      } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "owner_id", "metl_id", "standard_ref", "aliases"], "properties": {
        "kind": { "const": "capability" }, "owner_id": { "type": "string", "pattern": "^ORG-[A-Za-z0-9_-]+$" }, "metl_id": { "$ref": "common.schema.json#/$defs/id" },
        "standard_ref": { "$ref": "common.schema.json#/$defs/artifact_ref" },
        "aliases": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["operational_role", "task"], "properties": {
          "operational_role": { "enum": ["COS", "S2", "S3", "S4", "S6", "RED_TEAM", "EVALUATOR", "EXECUTOR", "RECORDER"] }, "task": { "type": "string", "minLength": 1, "maxLength": 2048 }
        } } }
      } },
      { "type": "object", "additionalProperties": false,
        "required": ["kind", "owner_id", "provider", "principal_sha256", "model_id", "model_revision", "harness_sha256", "prompt_sha256", "tool_schema_sha256", "tool_policy_sha256", "execution_profile_sha256"],
        "properties": { "kind": { "const": "performer" }, "owner_id": { "type": "string", "pattern": "^ORG-[A-Za-z0-9_-]+$" }, "provider": { "enum": ["codex", "claude", "other"] },
          "principal_sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "model_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "model_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
          "harness_sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "prompt_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "tool_schema_sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "tool_policy_sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "execution_profile_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    ] }
  }
}
